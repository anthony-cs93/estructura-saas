# Entorno
NODE_ENV=development
# Render inyecta PORT en el start command: no lo declares, genera un health check
# fallido y un loop de reinicio.
PORT=3001

# Base de datos Turso (libSQL)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Sesiones
JWT_SECRET=
SESSION_DAYS=7
# Nombre de la cookie de sesión
COOKIE_NAME=access_token
# SameSite de la cookie: lax (default) | strict | none
# `lax` para todo lo que NO cruce de origen (variantes C1 y C3 de 07-DEPLOY.md).
# `none` solo si el frontend llama al backend en otro dominio, y solo con HTTPS:
# los navegadores están retirando las cookies de terceros.
COOKIE_SAMESITE=lax
# Permite deshabilitar el registro público temporalmente
ALLOW_REGISTRATION=true

# CORS (lista separada por comas). Obligatoria en producción: sin ella la app
# arranca y falla en cada request. Irrelevante en C1 (proxy same-origin).
CORS_ORIGIN=http://localhost:5173

# Profundidad de proxies delante de la app. Se MIDE, no se adivina.
# Procedimiento y comando de verificación en 07-DEPLOY.md.
#   1 = Vercel serverless, o Render sin CDN delante
#   2 = Vercel -> Render (proxy same-origin)
#   3 = Render detrás de Cloudflare
TRUST_PROXY=1
